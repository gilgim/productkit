{
  "name": "productkit",
  "version": "0.1.0-beta.2",
  "description": "Turn natural-language product ideas into a traceable Product Definition and OpenSpec handoff",
  "type": "module",
  "bin": {
    "productkit": "dist/cli/bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "templates",
    "skills",
    "CONSTITUTION.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "node -e \"require('fs').existsSync('dist/cli/bin.js')||require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "keywords": [
    "product",
    "openspec",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.14.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
